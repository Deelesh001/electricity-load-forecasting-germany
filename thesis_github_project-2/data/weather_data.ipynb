# ============================================================
# 01 — WEATHER DATA COLLECTION
# Open-Meteo Historical Weather API / ERA5-Land
# ============================================================

from pathlib import Path
import time
import requests
import pandas as pd


# ============================================================
# 1. PROJECT PATHS
# ============================================================

# Run this notebook from:
# germany-electricity-load-forecasting/notebooks/

PROJECT_ROOT = Path.cwd().parent
WEATHER_DIR = PROJECT_ROOT / "data" / "raw" / "weather"

WEATHER_DIR.mkdir(parents=True, exist_ok=True)

OUTPUT_FILE = WEATHER_DIR / "weather_germany_hourly_2015_2025.csv"

print("Project root:", PROJECT_ROOT)
print("Weather output:", OUTPUT_FILE)


# ============================================================
# 2. CONFIGURATION
# ============================================================

API_URL = "https://archive-api.open-meteo.com/v1/archive"

START_DATE = "2015-01-01"
END_DATE = "2025-12-31"

CITIES = {
    "hamburg": {
        "latitude": 53.5511,
        "longitude": 9.9937,
    },
    "berlin": {
        "latitude": 52.5200,
        "longitude": 13.4050,
    },
    "cologne": {
        "latitude": 50.9375,
        "longitude": 6.9603,
    },
    "frankfurt": {
        "latitude": 50.1109,
        "longitude": 8.6821,
    },
    "munich": {
        "latitude": 48.1351,
        "longitude": 11.5820,
    },
}

HOURLY_VARIABLES = [
    "temperature_2m",
    "relative_humidity_2m",
]


# ============================================================
# 3. API FUNCTION
# ============================================================

def download_city_weather(
    city_name,
    latitude,
    longitude,
    start_date,
    end_date,
):
    """
    Download hourly historical ERA5-Land weather data
    from Open-Meteo for one location.
    """

    params = {
        "latitude": latitude,
        "longitude": longitude,
        "start_date": start_date,
        "end_date": end_date,
        "hourly": ",".join(HOURLY_VARIABLES),
        "timezone": "UTC",
        "models": "era5_land",
    }

    response = requests.get(
        API_URL,
        params=params,
        timeout=120,
    )

    response.raise_for_status()

    data = response.json()

    if "hourly" not in data:
        raise ValueError(
            f"No hourly weather data returned for {city_name}."
        )

    hourly = data["hourly"]

    df = pd.DataFrame({
        "timestamp": pd.to_datetime(
            hourly["time"],
            utc=True,
        ),
        f"temperature_{city_name}": hourly["temperature_2m"],
        f"humidity_{city_name}": hourly["relative_humidity_2m"],
    })

    return df


# ============================================================
# 4. DOWNLOAD ALL FIVE LOCATIONS
# ============================================================

city_frames = []

for city_name, coordinates in CITIES.items():

    print(f"Downloading {city_name.title()}...")

    city_df = download_city_weather(
        city_name=city_name,
        latitude=coordinates["latitude"],
        longitude=coordinates["longitude"],
        start_date=START_DATE,
        end_date=END_DATE,
    )

    city_frames.append(city_df)

    print(
        f"  {len(city_df):,} rows | "
        f"{city_df['timestamp'].min()} -> "
        f"{city_df['timestamp'].max()}"
    )

    # Small pause between requests
    time.sleep(1)


# ============================================================
# 5. MERGE CITY WEATHER DATA
# ============================================================

weather_wide = city_frames[0]

for city_df in city_frames[1:]:

    weather_wide = weather_wide.merge(
        city_df,
        on="timestamp",
        how="inner",
        validate="one_to_one",
    )


weather_wide = (
    weather_wide
    .sort_values("timestamp")
    .reset_index(drop=True)
)

print("\nMerged weather shape:", weather_wide.shape)


# ============================================================
# 6. CREATE GERMANY WEATHER PROXY
# ============================================================

temperature_columns = [
    f"temperature_{city}"
    for city in CITIES
]

humidity_columns = [
    f"humidity_{city}"
    for city in CITIES
]


weather_wide["temperature_mean"] = (
    weather_wide[temperature_columns]
    .mean(axis=1)
)

weather_wide["humidity_mean"] = (
    weather_wide[humidity_columns]
    .mean(axis=1)
)


# Final weather dataset used by preprocessing
weather = weather_wide[
    [
        "timestamp",
        "temperature_mean",
        "humidity_mean",
    ]
].copy()


# ============================================================
# 7. DATA QUALITY CHECKS
# ============================================================

weather = (
    weather
    .sort_values("timestamp")
    .reset_index(drop=True)
)


# Expected continuous hourly UTC timeline
expected_index = pd.date_range(
    start=f"{START_DATE} 00:00:00",
    end=f"{END_DATE} 23:00:00",
    freq="h",
    tz="UTC",
)


assert len(weather) == len(expected_index), (
    f"Unexpected row count: {len(weather):,}. "
    f"Expected: {len(expected_index):,}."
)


assert not weather["timestamp"].duplicated().any(), (
    "Duplicate timestamps found."
)


assert weather.isna().sum().sum() == 0, (
    "Missing weather values found."
)


assert weather["timestamp"].equals(
    pd.Series(
        expected_index,
        name="timestamp",
    )
), "Weather timeline is not continuous hourly UTC."


assert weather["humidity_mean"].between(
    0,
    100,
).all(), "Humidity outside expected range."


assert weather["temperature_mean"].between(
    -50,
    60,
).all(), "Temperature outside expected range."


print("\nAll weather quality checks passed.")


# ============================================================
# 8. SAVE CSV
# ============================================================

weather.to_csv(
    OUTPUT_FILE,
    index=False,
)


print("\nWeather data saved successfully:")
print(OUTPUT_FILE)

print("\nShape:", weather.shape)

print("\nColumns:")
print(weather.columns.tolist())

print("\nFirst rows:")
display(weather.head())

print("\nLast rows:")
display(weather.tail())
